font-family = JetBrainsMono Nerd Font Mono
font-size = 12
font-style = Regular
font-thicken = true
font-feature = calt
font-feature = liga
font-feature = ss01

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
theme = kanso-ink

macos-option-as-alt = true

keybind = ctrl+a=unbind
keybind = alt+left=unbind
keybind = alt+right=unbind
