// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor && VimControl && vim_mode == normal && !menu",
    "bindings": {
      "ctrl-shift-h": "workspace::ActivatePaneLeft",
      "ctrl-shift-j": "workspace::ActivatePaneDown",
      "ctrl-shift-k": "workspace::ActivatePaneUp",
      "ctrl-shift-l": "workspace::ActivatePaneRight",
      "space s v": "pane::SplitRight",
      "space s h": "pane::SplitDown",
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",
      "space b d": "pane::CloseActiveItem",
      "space e": "project_panel::Toggle",
      "space f f": "file_finder::Toggle",
      "space f g": "pane::DeploySearch",
      "space f b": "tab_switcher::Toggle",
      "space f r": "projects::OpenRecent",
      "space f o": "outline_panel::ToggleFocus",
      "space f s": "outline::Toggle",
      "space f d": "diagnostics::Deploy",
      "g d": "editor::GoToDefinition",
      "g D": "editor::GoToTypeDefinition",
      "g r": "editor::FindAllReferences",
      "g i": "editor::GoToImplementation",
      "shift-k": "editor::Hover",
      "space l a": "editor::ToggleCodeActions",
      "space l r": "editor::Rename",
      "space l f": "editor::Format",
      "space l d": "editor::Hover",
      "space l shift-r": [
        "editor::FindAllReferences",
        { "open_results_in": "multi_buffer" },
      ],
      "space l shift-d": [
        "editor::GoToDefinition",
        { "open_results_in": "multi_buffer" },
      ],
      "space l shift-i": [
        "editor::GoToImplementation",
        { "open_results_in": "multi_buffer" },
      ],
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",
      "space g p": "editor::ToggleSelectedDiffHunks",
      "space g s": "git::StageAndNext",
      "space g r": "git::Restore",
      "space g b": "git::Blame",
      "space w": "workspace::Save",
      "space q q": "zed::Quit",
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
    },
  },
  {
    "context": "Editor && vim_mode == visual && !VimWaiting",
    "bindings": {
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
      "space l a": "editor::ToggleCodeActions",
      "space l f": "editor::Format",
    },
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "ctrl-shift-l": "workspace::ActivatePaneRight",
    },
  },
  {
    "context": "GitPanel",
    "bindings": {
      "ctrl-shift-l": "workspace::ActivatePaneRight",
    },
  },
  {
    "context": "Editor && multibuffer && vim_mode == normal",
    "bindings": {
      "n": "search::SelectNextMatch",
      "shift-n": "search::SelectPreviousMatch",
      "ctrl-n": "editor::MoveToStartOfNextExcerpt",
      "ctrl-p": "editor::MoveToEndOfPreviousExcerpt",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-shift-h": "workspace::ActivatePaneLeft",
      "ctrl-shift-j": "workspace::ActivatePaneDown",
      "ctrl-shift-k": "workspace::ActivatePaneUp",
      "ctrl-shift-l": "workspace::ActivatePaneRight",
    },
  },
]
