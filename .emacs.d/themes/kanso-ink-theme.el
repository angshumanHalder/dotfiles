;; See KANSO-LICENSE in this directory.

;;; Commentary:
;; Kanso Ink's default (not saturated) palette, mapped to Emacs faces.
;; Frame transparency is intentionally independent of the theme.

;;; Code:

(deftheme kanso-ink "Kanso Ink: quiet blue-black backgrounds and muted syntax."
  :background-mode 'dark)

(let ((bg "#14171d") (panel "#1f1f26") (line "#22262D")
      (selection "#393B44") (search "#2D4F67")
      (fg "#C5C9C7") (bright "#f2f1ef") (dim "#A4A7A4")
      (comment "#75797f") (muted "#5C6066") (punct "#909398")
      (keyword "#8992a7") (fun "#8ba4b0") (type "#8ea4a2")
      (string "#8a9a7b") (number "#a292a3") (constant "#b6927b")
      (special "#c4b28a") (regex "#c4746e")
      (red "#C34043") (green "#98BB6C") (yellow "#DCA561")
      (info "#658594") (hint "#6A9589") (added "#76946A")
      (diff-add "#2B3328") (diff-delete "#43242B")
      (diff-change "#252535") (diff-text "#49443C"))
  (custom-theme-set-faces
   'kanso-ink
   ;; Editor and standard UI.
   `(default ((t (:foreground ,fg :background ,bg))))
   `(cursor ((t (:background ,bright))))
   `(fringe ((t (:foreground ,muted :background ,bg))))
   `(vertical-border ((t (:foreground ,line))))
   `(window-divider ((t (:foreground ,line))))
   `(window-divider-first-pixel ((t (:foreground ,line))))
   `(window-divider-last-pixel ((t (:foreground ,line))))
   `(region ((t (:background ,selection))))
   `(highlight ((t (:background ,selection))))
   `(hl-line ((t (:background ,line))))
   `(shadow ((t (:foreground ,comment))))
   `(minibuffer-prompt ((t (:foreground ,fun :weight bold))))
   `(link ((t (:foreground ,fun :underline t))))
   `(link-visited ((t (:foreground ,number :underline t))))
   `(button ((t (:foreground ,fun :weight bold))))
   `(header-line ((t (:foreground ,dim :background ,panel :box nil))))
   `(tooltip ((t (:foreground ,fg :background ,panel))))
   `(line-number ((t (:foreground ,muted :background ,bg))))
   `(line-number-current-line ((t (:foreground ,bright :background ,line :weight bold))))
   `(trailing-whitespace ((t (:background ,diff-delete))))
   `(whitespace-space ((t (:foreground "#4b4e57"))))
   `(whitespace-tab ((t (:foreground "#4b4e57"))))
   `(escape-glyph ((t (:foreground ,special))))
   `(success ((t (:foreground ,green))))
   `(warning ((t (:foreground ,yellow))))
   `(error ((t (:foreground ,red :weight bold))))
   ;; Search and matching delimiters.
   `(isearch ((t (:foreground ,bright :background ,search))))
   `(lazy-highlight ((t (:foreground ,fg :background ,diff-text))))
   `(match ((t (:foreground ,bright :background ,search))))
   `(isearch-fail ((t (:foreground ,bright :background ,diff-delete))))
   `(evil-ex-lazy-highlight ((t (:inherit lazy-highlight))))
   `(evil-ex-search ((t (:inherit isearch))))
   `(show-paren-match ((t (:foreground ,bright :background ,selection :weight bold))))
   `(show-paren-mismatch ((t (:foreground ,red :background ,diff-delete))))
   ;; Font-lock also supplies the standard faces used by built-in treesit modes.
   `(font-lock-comment-face ((t (:foreground ,comment :slant italic))))
   `(font-lock-comment-delimiter-face ((t (:inherit font-lock-comment-face))))
   `(font-lock-doc-face ((t (:foreground ,comment))))
   `(font-lock-doc-markup-face ((t (:foreground ,special))))
   `(font-lock-string-face ((t (:foreground ,string))))
   `(font-lock-keyword-face ((t (:foreground ,keyword))))
   `(font-lock-builtin-face ((t (:foreground ,special))))
   `(font-lock-function-name-face ((t (:foreground ,fun))))
   `(font-lock-function-call-face ((t (:foreground ,fun))))
   `(font-lock-variable-name-face ((t (:foreground ,fg))))
   `(font-lock-variable-use-face ((t (:foreground ,fg))))
   `(font-lock-type-face ((t (:foreground ,type))))
   `(font-lock-constant-face ((t (:foreground ,constant))))
   `(font-lock-number-face ((t (:foreground ,number))))
   `(font-lock-operator-face ((t (:foreground ,punct))))
   `(font-lock-punctuation-face ((t (:foreground ,punct))))
   `(font-lock-bracket-face ((t (:foreground ,punct))))
   `(font-lock-delimiter-face ((t (:foreground ,punct))))
   `(font-lock-property-name-face ((t (:foreground ,type))))
   `(font-lock-property-use-face ((t (:foreground ,type))))
   `(font-lock-preprocessor-face ((t (:foreground ,punct))))
   `(font-lock-regexp-grouping-backslash ((t (:foreground ,regex))))
   `(font-lock-regexp-grouping-construct ((t (:foreground ,regex))))
   `(font-lock-escape-face ((t (:foreground ,special))))
   `(font-lock-warning-face ((t (:inherit warning))))
   ;; Completion, navigation, and dashboard.
   `(completions-common-part ((t (:foreground ,fun :weight bold))))
   `(completions-first-difference ((t (:foreground ,constant))))
   `(vertico-current ((t (:foreground ,bright :background ,selection))))
   `(corfu-default ((t (:foreground ,bright :background ,bg))))
   `(corfu-current ((t (:foreground ,bright :background ,selection))))
   `(corfu-border ((t (:background ,line))))
   `(corfu-bar ((t (:background ,selection))))
   `(orderless-match-face-0 ((t (:foreground ,fun :weight bold))))
   `(orderless-match-face-1 ((t (:foreground ,number :weight bold))))
   `(orderless-match-face-2 ((t (:foreground ,string :weight bold))))
   `(orderless-match-face-3 ((t (:foreground ,special :weight bold))))
   `(consult-file ((t (:foreground ,fg))))
   `(consult-preview-match ((t (:inherit match))))
   `(marginalia-documentation ((t (:foreground ,comment))))
   `(embark-target ((t (:background ,selection :underline t))))
   `(which-key-key-face ((t (:foreground ,fun))))
   `(which-key-group-description-face ((t (:foreground ,keyword))))
   `(treemacs-root-face ((t (:foreground ,fun :weight bold :height 1.1))))
   `(treemacs-directory-face ((t (:foreground ,fun))))
   `(treemacs-file-face ((t (:foreground ,fg))))
   `(treemacs-git-modified-face ((t (:foreground ,yellow))))
   `(treemacs-git-added-face ((t (:foreground ,added))))
   `(treemacs-git-untracked-face ((t (:foreground ,comment))))
   `(treemacs-git-conflict-face ((t (:foreground ,red))))
   `(dashboard-heading ((t (:foreground ,fun :weight bold))))
   `(dashboard-banner-logo-title ((t (:foreground ,bright :weight bold))))
   `(dashboard-items-face ((t (:foreground ,fg))))
   `(dashboard-footer-face ((t (:foreground ,comment))))
   `(dired-directory ((t (:foreground ,fun))))
   `(dired-symlink ((t (:foreground ,type))))
   ;; Mode line and Doom Modeline.
   `(mode-line ((t (:foreground ,fg :background ,line :box nil))))
   `(mode-line-inactive ((t (:foreground ,comment :background ,panel :box nil))))
   `(mode-line-buffer-id ((t (:foreground ,bright :weight bold))))
   `(doom-modeline-bar ((t (:background ,fun))))
   `(doom-modeline-bar-inactive ((t (:background ,selection))))
   `(doom-modeline-buffer-path ((t (:foreground ,dim))))
   `(doom-modeline-buffer-file ((t (:foreground ,bright :weight bold))))
   `(doom-modeline-buffer-modified ((t (:foreground ,yellow))))
   `(doom-modeline-evil-normal-state ((t (:foreground ,fg))))
   `(doom-modeline-evil-insert-state ((t (:foreground ,green))))
   `(doom-modeline-evil-visual-state ((t (:foreground ,keyword))))
   `(doom-modeline-evil-replace-state ((t (:foreground ,constant))))
   `(doom-modeline-info ((t (:foreground ,info))))
   `(doom-modeline-warning ((t (:foreground ,yellow))))
   `(doom-modeline-urgent ((t (:foreground ,red))))
   ;; Diagnostics, version control, and diffs.
   `(flymake-error ((t (:underline (:style wave :color ,red)))))
   `(flymake-warning ((t (:underline (:style wave :color ,yellow)))))
   `(flymake-note ((t (:underline (:style wave :color ,hint)))))
   `(flymake-error-echo ((t (:foreground ,red))))
   `(flymake-warning-echo ((t (:foreground ,yellow))))
   `(flymake-note-echo ((t (:foreground ,hint))))
   `(eglot-highlight-symbol-face ((t (:background ,selection))))
   `(eglot-diagnostic-tag-unnecessary-face ((t (:foreground ,comment))))
   `(eglot-diagnostic-tag-deprecated-face ((t (:strike-through t))))
   `(diff-added ((t (:foreground ,string :background ,diff-add))))
   `(diff-removed ((t (:foreground ,regex :background ,diff-delete))))
   `(diff-changed ((t (:background ,diff-change))))
   `(diff-refine-added ((t (:foreground ,green :background ,diff-add :weight bold))))
   `(diff-refine-removed ((t (:foreground ,red :background ,diff-delete :weight bold))))
   `(diff-refine-changed ((t (:background ,diff-text :weight bold))))
   `(diff-header ((t (:foreground ,fun :background ,panel))))
   `(diff-file-header ((t (:foreground ,bright :background ,line :weight bold))))
   `(diff-hunk-header ((t (:foreground ,keyword :background ,diff-change))))
   `(diff-hl-insert ((t (:foreground ,added :background ,bg))))
   `(diff-hl-delete ((t (:foreground ,red :background ,bg))))
   `(diff-hl-change ((t (:foreground ,yellow :background ,bg))))
   `(diff-hl-margin-insert ((t (:inherit diff-hl-insert))))
   `(diff-hl-margin-delete ((t (:inherit diff-hl-delete))))
   `(diff-hl-margin-change ((t (:inherit diff-hl-change))))
   `(magit-section-heading ((t (:foreground ,fun :weight bold))))
   `(magit-section-highlight ((t (:background ,panel))))
   `(magit-branch-local ((t (:foreground ,fun :weight bold))))
   `(magit-branch-remote ((t (:foreground ,string))))
   `(magit-hash ((t (:foreground ,comment))))
   `(magit-diff-added ((t (:inherit diff-added))))
   `(magit-diff-added-highlight ((t (:inherit diff-added :foreground ,green))))
   `(magit-diff-removed ((t (:inherit diff-removed))))
   `(magit-diff-removed-highlight ((t (:inherit diff-removed :foreground ,red))))
   `(magit-diff-context ((t (:foreground ,dim :background ,bg))))
   `(magit-diff-context-highlight ((t (:foreground ,fg :background ,panel))))
   `(magit-diff-hunk-heading ((t (:inherit diff-hunk-header))))
   `(magit-diff-hunk-heading-highlight ((t (:foreground ,bright :background ,selection))))
   `(magit-diff-file-heading ((t (:foreground ,bright :weight bold))))
   ;; Agent-shell uses standard diff faces for its diff buffers.
   `(agent-shell-header ((t (:foreground ,fun :background ,panel))))
   `(agent-shell-section-heading ((t (:foreground ,fun :weight bold))))
   `(agent-shell-section-annotation ((t (:foreground ,comment))))
   `(agent-shell-thought-body ((t (:foreground ,dim :slant italic))))
   `(agent-shell-secondary ((t (:foreground ,comment))))
   `(agent-shell-success ((t (:foreground ,green))))
   `(agent-shell-warning ((t (:foreground ,yellow))))
   `(agent-shell-error ((t (:foreground ,red))))
   `(agent-shell-pending ((t (:foreground ,yellow))))
   `(agent-shell-prompt ((t (:foreground ,fun :weight bold))))
   `(agent-shell-input ((t (:foreground ,fg))))
   `(agent-shell-permission-title ((t (:foreground ,yellow :weight bold))))
   `(agent-shell-chat-me-label ((t (:foreground ,fun :weight bold))))
   `(agent-shell-chat-agent-label ((t (:foreground ,type :weight bold))))
   `(agent-shell-markdown-inline-code ((t (:foreground ,string :background ,panel))))
   `(agent-shell-markdown-source-block ((t (:background ,panel))))
   `(agent-shell-markdown-blockquote ((t (:foreground ,comment :slant italic))))
   `(agent-shell-markdown-link ((t (:inherit link))))
   ;; Prose and markup.
   `(outline-1 ((t (:foreground ,fun :weight bold))))
   `(outline-2 ((t (:foreground ,type :weight bold))))
   `(outline-3 ((t (:foreground ,special :weight bold))))
   `(outline-4 ((t (:foreground ,number :weight bold))))
   `(org-block ((t (:background ,panel))))
   `(org-code ((t (:foreground ,string))))
   `(org-verbatim ((t (:foreground ,string))))
   `(org-todo ((t (:foreground ,yellow :weight bold))))
   `(org-done ((t (:foreground ,green :weight bold))))
   `(markdown-code-face ((t (:background ,panel))))
   `(markdown-inline-code-face ((t (:foreground ,string))))
   `(markdown-header-face ((t (:foreground ,fun :weight bold))))
   `(markdown-header-face-1 ((t (:inherit markdown-header-face :height 1.6))))
   `(markdown-header-face-2 ((t (:inherit markdown-header-face :height 1.4))))
   `(markdown-header-face-3 ((t (:inherit markdown-header-face :height 1.25))))
   `(markdown-header-face-4 ((t (:inherit markdown-header-face :height 1.15))))
   `(markdown-header-face-5 ((t (:inherit markdown-header-face :height 1.1))))
   `(markdown-header-face-6 ((t (:inherit markdown-header-face :height 1.0))))
   `(markdown-ts-heading-1 ((t (:foreground ,fun :weight bold :height 1.6))))
   `(markdown-ts-heading-2 ((t (:foreground ,fun :weight bold :height 1.4))))
   `(markdown-ts-heading-3 ((t (:foreground ,fun :weight bold :height 1.25))))
   `(markdown-ts-heading-4 ((t (:foreground ,fun :weight bold :height 1.15))))
   `(markdown-ts-heading-5 ((t (:foreground ,fun :weight bold :height 1.1))))
   `(markdown-ts-heading-6 ((t (:foreground ,fun :weight bold :height 1.0))))
   `(markdown-ts-code-block ((t (:inherit fixed-pitch :background ,panel :extend t))))
   `(markdown-ts-code-span ((t (:inherit fixed-pitch :foreground ,string :background ,panel))))
   `(markdown-ts-bold ((t (:weight bold))))
   `(markdown-ts-emphasis ((t (:slant italic))))
   `(markdown-link-face ((t (:inherit link))))
   `(hl-todo ((t (:foreground ,yellow :weight bold))))
   ;; ANSI colors for shell/compilation output.
   `(ansi-color-black ((t (:foreground ,bg :background ,bg))))
   `(ansi-color-red ((t (:foreground ,regex :background ,regex))))
   `(ansi-color-green ((t (:foreground ,string :background ,string))))
   `(ansi-color-yellow ((t (:foreground ,special :background ,special))))
   `(ansi-color-blue ((t (:foreground ,fun :background ,fun))))
   `(ansi-color-magenta ((t (:foreground ,number :background ,number))))
   `(ansi-color-cyan ((t (:foreground ,fg :background ,fg))))
   `(ansi-color-white ((t (:foreground ,dim :background ,dim))))
   `(ansi-color-bright-black ((t (:foreground ,punct :background ,punct))))
   `(ansi-color-bright-red ((t (:foreground "#E46876" :background "#E46876"))))
   `(ansi-color-bright-green ((t (:foreground "#87a987" :background "#87a987"))))
   `(ansi-color-bright-yellow ((t (:foreground "#E6C384" :background "#E6C384"))))
   `(ansi-color-bright-blue ((t (:foreground "#7FB4CA" :background "#7FB4CA"))))
   `(ansi-color-bright-magenta ((t (:foreground "#938AA9" :background "#938AA9"))))
   `(ansi-color-bright-cyan ((t (:foreground "#7AA89F" :background "#7AA89F"))))
   `(ansi-color-bright-white ((t (:foreground ,fg :background ,fg))))))

(provide-theme 'kanso-ink)
;;; kanso-ink-theme.el ends here
